{
    "main": {
        "config": "infection.json5",
        "threads": 3,
        "sources": [
            "src/Privacy",
            "src/Coalescing",
            "src/Outbox",
            "src/Command",
            "src/Elasticsearch",
            "src/Model",
            "src/Reader",
            "src/Writer",
            "src/Transport"
        ],
        "parts": {
            "all": ["*"]
        }
    },
    "doctrine": {
        "config": "infection.doctrine.json5",
        "threads": 3,
        "sources": ["src/Doctrine"],
        "parts": {
            "subscriber": ["src/Doctrine/AuditSubscriber.php"],
            "replay": ["src/Doctrine/Observation/HistoryReplay.php"],
            "shape": [
                "src/Doctrine/Observation/StatementShape.php",
                "src/Doctrine/Observation/WatchedRows.php"
            ],
            "log": [
                "src/Doctrine/Observation/StatementLog.php",
                "src/Doctrine/Observation/LookRightAfter.php",
                "src/Doctrine/Observation/NobodysStatement.php"
            ],
            "memory": [
                "src/Doctrine/Observation/RowMemory.php",
                "src/Doctrine/Observation/JoinRowMemory.php",
                "src/Doctrine/Observation/JoinRowsQuery.php"
            ],
            "links": [
                "src/Doctrine/Observation/LinkFacts.php",
                "src/Doctrine/Observation/LinkRuns.php",
                "src/Doctrine/Observation/EntityRowRuns.php",
                "src/Doctrine/Observation/ElementFieldRuns.php"
            ],
            "rest": ["*"]
        }
    }
}
