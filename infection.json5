{
    // Mutation testing, run through Docker because Infection needs a coverage driver
    // and a workstation need not have one: tools/infection/run.sh, and the Dockerfile
    // next to it for why pcov rather than Xdebug.
    //
    // What is listed here is where a silent defect costs most: redaction (a value that
    // escapes cannot be recalled), the frame buffer (records held and merged), the
    // outbox (the commit that must not happen without its history), the commands an
    // operator trusts, the Elasticsearch boundary, the query and the reader, and — since
    // every record in production goes through them — the writer and the Messenger
    // transport. What is left out of src/ is wiring and vocabulary: the container
    // extension, the Doctrine listener (its own configuration, for the reason written
    // there), the events, the exceptions. The ordinary suite covers those, and they are
    // not held to a mutation score.
    $schema: "tools/infection/vendor/infection/infection/resources/schema.json",
    source: {
        directories: [
            "src/Privacy",
            "src/Coalescing",
            "src/Outbox",
            "src/Command",
            "src/Elasticsearch",
            "src/Model",
            "src/Reader",
            "src/Writer",
            "src/Transport",
        ],
    },
    logs: {
        text: "var/infection/escaped.log",
        summary: "var/infection/summary.log",
        // What tools/infection/gate.php checks a part against the plan with.
        json: "var/infection/main.json",
    },
    mutators: {
        "@default": true,

        // Nothing is ignored here. A mutation is left out of the count only by a record in
        // tools/infection/exclusions.json, argued from PHP, which gate.php holds to the plan
        // made without it. The line ignores that stood here were moved there where their
        // argument was PHP's, and taken back into the count where it was about what a
        // caller, Elasticsearch or Messenger does -- tools/infection/TRIAGE-1.3.md lists each.
    },
    // The floor, not the goal, and deliberately below where the suite actually stands
    // (99, and still 99 with the writer and the transport added — 2,460 mutants, none
    // of them escaping in either of those two). The score is not
    // quite deterministic: a mutant that loops forever is counted as killed, and one
    // sitting near the timeout is counted as killed or not depending on what else the
    // machine was doing — the same commit measured 89 and then 88 minutes apart. A floor
    // set at the best observed number turns that into a CI job that fails for no reason,
    // and a check nobody trusts is worse than none. So it moves up a group at a time,
    // with room underneath — two points here, against the one point of drift seen so far. 87 is what it scored the first time it was
    // measured on a stand that was not lying (see the Dockerfile): it is here so the
    // number cannot quietly go down while the code grows, and it is raised as each
    // group of escaped mutants is worked through rather than set aspirationally and
    // ignored. Of the covered rather than of all because uncovered code is the coverage
    // floor's business, and tools/coverage-floor.php already owns that argument.
    //
    // The floor is no longer here. It is the set's `floor` in tools/infection/parts.json,
    // held by gate.php to what a test failed on alone -- a timeout is the machine's as often
    // as the mutant's -- and compared in integers, with no rounding up. Infection is given
    // no floor of its own: one number, held in one place.
    // High enough that nothing is skipped, which is what decides it — and the gate
    // (tools/infection/gate.php) refuses a run that skipped any, so that a timeout lowered
    // for speed shows up as a red job rather than as a score over fewer mutants. Infection
    // skips a mutant, uncounted, when the tests covering its line add up to more than this,
    // and the writer's and the frame's lines are covered by nearly the whole suite: every
    // Doctrine test writes through them, about ninety seconds under coverage. At 10 it was
    // skipping 494 of 2,663 mutants (202 before 1.3, and growing) under a green gate.
    //
    // What it costs is the mutants that loop: a removed budget in the redactor or the
    // frame now runs for two minutes rather than ten seconds. There were thirteen.
    timeout: 120,
    // The listener's memory bar is a measurement of five thousand entities, not a test of
    // behaviour: it adds seconds to every mutant whose line it passes and decides none of
    // them. It runs in the ordinary suite. A group given here replaces phpunit.xml.dist's
    // rather than adding to them, so those two are repeated — one flag each: PHPUnit 12
    // reads "a,b" as the name of one group, excludes nothing, and runs the integration tests.
    testFrameworkExtraArgs: "--exclude-group=integration --exclude-group=benchmark --exclude-group=budget",
}
