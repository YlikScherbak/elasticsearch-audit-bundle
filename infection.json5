{
    // Mutation testing, run through Docker because Infection needs a coverage driver
    // and a workstation need not have one: tools/infection/run.sh, and the Dockerfile
    // next to it for why pcov rather than Xdebug.
    //
    // What is listed here is where a silent defect costs most: redaction (a value that
    // escapes cannot be recalled), the frame buffer (records held and merged), the
    // outbox (the commit that must not happen without its history), the commands an
    // operator trusts, the Elasticsearch boundary, the query and the reader, and — since
    // every record in production goes through them — the writer and the Messenger
    // transport. What is left out of src/ is wiring and vocabulary: the container
    // extension, the Doctrine listener (its own configuration, for the reason written
    // there), the events, the exceptions. The ordinary suite covers those, and they are
    // not held to a mutation score.
    $schema: "tools/infection/vendor/infection/infection/resources/schema.json",
    source: {
        directories: [
            "src/Privacy",
            "src/Coalescing",
            "src/Outbox",
            "src/Command",
            "src/Elasticsearch",
            "src/Model",
            "src/Reader",
            "src/Writer",
            "src/Transport",
        ],
    },
    logs: {
        text: "var/infection/escaped.log",
        summary: "var/infection/summary.log",
    },
    mutators: {
        "@default": true,

        // Every ignore below names a LINE — "Class::method::123" — and not just a
        // method. Infection matches the three forms with fnmatch, and the method form
        // switches the mutator off for everything in that method, including whatever is
        // added to it next year: a claim made once about one expression quietly grows to
        // cover code nobody has looked at. Two of the claims here were already wrong
        // (see the frame buffer, below) and the method form is why that could not
        // surface.
        //
        // The cost is that editing a method above one of these lines makes the number
        // stale, the mutant is generated again, and the mutation job goes red. That is
        // the right way round: "this mutant is equivalent" is a statement about one
        // expression, and it should not survive a change to the method it lives in
        // without somebody saying so again. Re-run tools/infection/run.sh and read the
        // escaped list for the new line.
        //
        // Equivalent mutants, listed rather than left in the escaped pile for the next
        // person to work out again. In ClusterVersion the version is matched by (\d+),
        // so $found[1] and $found[2] are always digit strings: dropping the (int) leaves
        // PHP comparing a numeric string to an int, which it does numerically and with
        // the same answer. And $found[0] is the whole match, which begins with the major
        // digits, so (int) $found[0] and (int) $found[1] cannot differ. No test can tell
        // these apart, because there is nothing to tell apart.
        CastInt: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Elasticsearch\\ClusterVersion::knowsIncludeSourceOnError::34", "Borsche\\ElasticsearchAuditBundle\\Coalescing\\NumericNullAsZeroComparator::decimal::124", "Borsche\\ElasticsearchAuditBundle\\Command\\CheckCommand::windowDrift::254"],
        },

        // The gateway's equivalents, each worked out once from the code rather than
        // guessed at from the name:
        //
        // - json_decode's depth argument (reason, isMissingSearchContext): an error body
        //   is three levels deep and the limit is 512, so 511 and 513 read it the same.
        // - $this->known[$index] = true (indexExists, createIndex): the value is only
        //   ever read through isset(), which does not care what it is.
        // - array_unique in bulk(): the loop under it sets $this->known on the first
        //   sight of an index, so a repeated one costs an isset() and no request. The
        //   call is genuinely redundant.
        // - the status range in call(): the official client raises ClientResponseException
        //   for 4xx only — a 5xx arrives as ServerResponseException and never reaches the
        //   line — so "< 500" and "<= 500" cannot be told apart from outside.
        // - refusedTheParameter's first guard: it is reached only from write(), where the
        //   exception always carries the client's own as its previous, so there is no
        //   answer for the other half of the || to change.
        // - the early return in isMissingSearchContext for a body that is not an array:
        //   what follows reads it through ?? , which yields null for a scalar anyway.
        DecrementInteger: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Elasticsearch\\ClusterVersion::knowsIncludeSourceOnError::34", "Borsche\\ElasticsearchAuditBundle\\Elasticsearch\\ElasticsearchGateway::reason::683", "Borsche\\ElasticsearchAuditBundle\\Elasticsearch\\ElasticsearchGateway::isMissingSearchContext::520", "Borsche\\ElasticsearchAuditBundle\\Model\\Cursor::decode::86", "Borsche\\ElasticsearchAuditBundle\\Model\\Cursor::queryOf::180", "Borsche\\ElasticsearchAuditBundle\\Model\\AuditPage::nextCursor::104", "Borsche\\ElasticsearchAuditBundle\\Coalescing\\NumericNullAsZeroComparator::decimal::114", "Borsche\\ElasticsearchAuditBundle\\Transport\\Messenger\\IndexAuditRecordHandler::__invoke::81", "Borsche\\ElasticsearchAuditBundle\\Transport\\Messenger\\IndexAuditRecordsHandler::__invoke::71", "Borsche\\ElasticsearchAuditBundle\\Transport\\Messenger\\IndexAuditRecordsHandler::__invoke::102", "Borsche\\ElasticsearchAuditBundle\\Transport\\Messenger\\MessengerTransport::whatTheHandlerSaid::77"],
        },
        IncrementInteger: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Elasticsearch\\ElasticsearchGateway::reason::683", "Borsche\\ElasticsearchAuditBundle\\Elasticsearch\\ElasticsearchGateway::isMissingSearchContext::520", "Borsche\\ElasticsearchAuditBundle\\Model\\Cursor::decode::86", "Borsche\\ElasticsearchAuditBundle\\Model\\Cursor::queryOf::180", "Borsche\\ElasticsearchAuditBundle\\Model\\AuditPage::nextCursor::104", "Borsche\\ElasticsearchAuditBundle\\Coalescing\\NumericNullAsZeroComparator::decimal::114", "Borsche\\ElasticsearchAuditBundle\\Transport\\Messenger\\IndexAuditRecordHandler::__invoke::81", "Borsche\\ElasticsearchAuditBundle\\Transport\\Messenger\\IndexAuditRecordsHandler::__invoke::71", "Borsche\\ElasticsearchAuditBundle\\Transport\\Messenger\\IndexAuditRecordsHandler::__invoke::102"],
        },
        TrueValue: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Elasticsearch\\ElasticsearchGateway::indexExists::420", "Borsche\\ElasticsearchAuditBundle\\Elasticsearch\\ElasticsearchGateway::createIndex::448"],
        },
        UnwrapArrayUnique: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Elasticsearch\\ElasticsearchGateway::bulk::322"],
        },
        LessThan: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Elasticsearch\\ElasticsearchGateway::call::629", "Borsche\\ElasticsearchAuditBundle\\Transport\\Messenger\\MessengerTransport::whatTheHandlerSaid::77"],
        },
        LogicalOr: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Elasticsearch\\ElasticsearchGateway::refusedTheParameter::247", "Borsche\\ElasticsearchAuditBundle\\Model\\Filter::crossed::112", "Borsche\\ElasticsearchAuditBundle\\Coalescing\\NumericNullAsZeroComparator::decimal::111"],
        },
        LogicalAnd: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Elasticsearch\\ElasticsearchGateway::call::629"],
        },
        ReturnRemoval: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Elasticsearch\\ElasticsearchGateway::isMissingSearchContext::526", "Borsche\\ElasticsearchAuditBundle\\Model\\Filter::crossed::113", "Borsche\\ElasticsearchAuditBundle\\Reader\\AuditReader::iterate::158"],
        },
        // The model's equivalents, worked out the same way as the gateway's:
        //
        // - json_decode's depth in Cursor: a token's envelope is three levels deep.
        // - array_key_last(...) ?? -1 in AuditPage: the fallback is reached only for an
        //   empty list, where every index is missing anyway.
        // - the version comparison in Cursor::fromAnotherVersion: it is called only for a
        //   version that is not this one, so > and >= have nothing to disagree about.
        // - the null guard in Filter::crossed: a range with both bounds null is refused
        //   before it gets there, and with one null the comparisons below answer false on
        //   their own.
        // - array_values() around a variadic (withObjectIds, withEvents, withIds,
        //   narrowObjectIds, narrowActors): PHP hands a variadic over as a list already.
        //   In narrowIn() and scalars() it wraps array_filter, where the keys really do
        //   survive - but both hand the result straight to Filter::in(), which lists it
        //   again. The tests hold that shape at the boundary that is observable.
        // - the (string) cast in Cursor::fromAnotherVersion: sprintf('%s') converts a
        //   scalar the same way, so the cast is documentation of intent and nothing more.
        // - AuditQuery::comparable: it exists only to be compared against itself, so a
        //   mutation renaming both sides of every comparison is not observable. What
        //   matters is that booleans and scalars land in different namespaces; that is
        //   tested.
        GreaterThan: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Model\\Cursor::fromAnotherVersion::217", "Borsche\\ElasticsearchAuditBundle\\Coalescing\\NumericNullAsZeroComparator::decimal::131"],
        },
        UnwrapArrayValues: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Model\\AuditQuery::withObjectIds::103", "Borsche\\ElasticsearchAuditBundle\\Model\\AuditQuery::withEvents::113", "Borsche\\ElasticsearchAuditBundle\\Model\\AuditQuery::withIds::126", "Borsche\\ElasticsearchAuditBundle\\Model\\AuditQuery::narrowObjectIds::219", "Borsche\\ElasticsearchAuditBundle\\Model\\AuditQuery::narrowActors::235", "Borsche\\ElasticsearchAuditBundle\\Model\\AuditQuery::narrowIn::274", "Borsche\\ElasticsearchAuditBundle\\Model\\AuditQuery::scalars::545", "Borsche\\ElasticsearchAuditBundle\\Coalescing\\FrameBuffer::hold::363", "Borsche\\ElasticsearchAuditBundle\\Coalescing\\FrameBuffer::hold::405", "Borsche\\ElasticsearchAuditBundle\\Command\\CheckCommand::diagnostic::281", "Borsche\\ElasticsearchAuditBundle\\Command\\CreateIndexCommand::diagnostic::113", "Borsche\\ElasticsearchAuditBundle\\Reader\\AuditReader::iterate::155", "Borsche\\ElasticsearchAuditBundle\\Writer\\IndexResolver::all::67"],
        },
        Concat: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Model\\AuditQuery::comparable::521", "Borsche\\ElasticsearchAuditBundle\\Coalescing\\NumericNullAsZeroComparator::trim::158", "Borsche\\ElasticsearchAuditBundle\\Coalescing\\NumericNullAsZeroComparator::trim::161"],
        },
        ConcatOperandRemoval: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Model\\AuditQuery::comparable::521", "Borsche\\ElasticsearchAuditBundle\\Coalescing\\NumericNullAsZeroComparator::trim::158"],
        },
        Ternary: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Model\\AuditQuery::comparable::521"],
        },
        // The reader's equivalents, all four of them found the day src/Reader was added
        // to the list above — which is also how the twenty-eight that were not equivalent
        // were found:
        //
        // - array_values() on a response's hits: Elasticsearch answers them as a JSON
        //   array, which json_decode gives back as a list, so the call is the type
        //   assertion the static analyser wants rather than a transformation.
        // - the early return for an empty batch: decorate() refuses an empty list of its
        //   own accord, the cursor read below answers [] when there is no last hit, and a
        //   count of zero is under every batch size — so the loop falls out one line
        //   later anyway. The return is there because "no hits means the export is over"
        //   is its own fact, not because the lines under it would misbehave.
        // - (string) on an aggregation's name, and on a key inside one: PHP turns a
        //   numeric-looking array key into an int, and both casts feed either a
        //   concatenation, which converts it the same way, or a strict in_array against a
        //   list of words, which an integer matches no better than a numeric string.
        CastString: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Model\\Cursor::fromAnotherVersion::221", "Borsche\\ElasticsearchAuditBundle\\Reader\\AuditReader::refuseGlobalAggregations::459", "Borsche\\ElasticsearchAuditBundle\\Reader\\AuditReader::refuseGlobalAggregations::470"],
        },

        // The numeric comparator's equivalents. Two reasons cover all of them, and both
        // are about the shape of the class rather than about any one line:
        //
        // 1. canonical() is only ever compared against another canonical(). A mutation
        //    that renames its output — a zero on the other end, a sign on the other side,
        //    a padding length that trim() removes again — renames both sides of every
        //    comparison, so no pair of values can tell it happened. What is observable is
        //    that two spellings of one quantity land on the same string and two
        //    quantities do not, and that is what the table tests.
        // 2. decimal() is reached only for a value is_numeric() has already accepted (or
        //    for var_export() of a finite float), which is a whole-string match by
        //    definition. Its anchors, its "has an e but did not parse" fallback and its
        //    defaults for absent capture groups are defences against input that cannot
        //    arrive through equals(). Worth keeping — the method is private and somebody
        //    may call it from somewhere else one day — and not worth a test that would
        //    have to reach past the guard to write one.
        PregMatchRemoveCaret: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Coalescing\\NumericNullAsZeroComparator::decimal::110"],
        },
        PregMatchRemoveDollar: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Coalescing\\NumericNullAsZeroComparator::decimal::110"],
        },
        ArrayItemRemoval: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Coalescing\\NumericNullAsZeroComparator::decimal::114", "Borsche\\ElasticsearchAuditBundle\\Command\\CreateIndexCommand::diagnostic::107"],
        },
        LessThanOrEqualTo: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Coalescing\\NumericNullAsZeroComparator::decimal::126"],
        },
        Minus: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Coalescing\\NumericNullAsZeroComparator::decimal::132"],
        },

        // The frame buffer's equivalents:
        //
        // Two claims used to stand here and no longer do. close() was said to be safe
        // from losing its forget() and its early return, on the grounds that refuse()
        // had already emptied the buffer — but forget() also clears the refusal, so a
        // buffer that keeps it answers the *next* operation with nothing as well, and
        // the suite says so. The ignores were the only reason nobody found out: an
        // ignored mutant is never generated, so a wrong equivalence claim cannot be
        // contradicted. Naming lines rather than methods is what turned that up.
        //
        // - array_values() around array_filter() of a one-element list: filter either
        //   keeps element 0 or leaves the list empty, and array_values() changes neither.
        //   Removing the filter is caught; removing the re-listing cannot be.
        // - `?? null` and `?? []` on an array read that PHP answers with null anyway.
        Coalesce: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Coalescing\\FrameBuffer::hold::356", "Borsche\\ElasticsearchAuditBundle\\Command\\CheckCommand::execute::83", "Borsche\\ElasticsearchAuditBundle\\Command\\MappingComparison::walk::72", "Borsche\\ElasticsearchAuditBundle\\Writer\\AuditWriter::prepare::525"],
        },
        // The writer's and the transport's equivalents:
        //
        // - the second redaction in AuditWriter::prepare(), after the RecordCreated
        //   event. It and RecordCreatedEvent::setRecord() cover the same outcome — a
        //   record a listener replaced reaches the transport redacted — and setRecord()
        //   redacts what it is handed, so no road to the transport reaches this line
        //   with an unredacted record. Measured both ways round: remove either and the
        //   test still passes, remove both and it fails (see
        //   TheLastStepsBeforeARecordLeavesTest, which says so in full). This is an
        //   equivalence about today's callers rather than about the expression: a road
        //   that does not pass setRecord() would make the line live again, and the
        //   number here going stale is how that would be noticed.
        // - the inner array_values() in IndexResolver::all(): spreading an array
        //   renumbers its integer keys and keeps its string ones, and array_unique()
        //   preserves whatever it is given, so the result is identical without it. The
        //   outer one is not equivalent and has its own test — which is why the two sit
        //   on separate lines now, so that this claim cannot quietly cover both.
        // - the 0 passed as the code of UnrecoverableMessageHandlingException in both
        //   handlers. Nothing reads it: Messenger keys off the class and the interface,
        //   and the status an operator needs is on the exception behind it, which
        //   WhatAHandlerSaysAboutARefusalTest asks for by getCode().
        // - the `$step < 8` bound in MessengerTransport::whatTheHandlerSaid(). It is a
        //   guard against walking a chain forever, and every value above the deepest
        //   chain this bundle builds — three links — behaves identically. Pinning 8 in
        //   a test would make an arbitrary number expensive to change and prove nothing.
        UnwrapArrayFilter: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Command\\CreateIndexCommand::diagnostic::113"],
        },

        // The commands' equivalents:
        //
        // - (int) on an index setting: Elasticsearch answers them as numeric strings and
        //   PHP compares those numerically, so the cast documents the type rather than
        //   changing the comparison.
        // - array_values() around array_unique() in diagnostic(): the result is imploded,
        //   and implode does not read keys. Dropping the unique() or the filter() is
        //   caught; dropping the re-listing cannot be.
        // - `?? '?'` for a cluster that answers with neither a cluster_name nor a name,
        //   and `?? null` for a mapping fragment that is neither typed nor an object:
        //   both are the last link of a chain whose earlier links are tested.
    },
    // The floor, not the goal, and deliberately below where the suite actually stands
    // (99, and still 99 with the writer and the transport added — 2,460 mutants, none
    // of them escaping in either of those two). The score is not
    // quite deterministic: a mutant that loops forever is counted as killed, and one
    // sitting near the timeout is counted as killed or not depending on what else the
    // machine was doing — the same commit measured 89 and then 88 minutes apart. A floor
    // set at the best observed number turns that into a CI job that fails for no reason,
    // and a check nobody trusts is worse than none. So it moves up a group at a time,
    // with room underneath — two points here, against the one point of drift seen so far. 87 is what it scored the first time it was
    // measured on a stand that was not lying (see the Dockerfile): it is here so the
    // number cannot quietly go down while the code grows, and it is raised as each
    // group of escaped mutants is worked through rather than set aspirationally and
    // ignored. minCoveredMsi rather than minMsi because uncovered code is the coverage
    // floor's business, and tools/coverage-floor.php already owns that argument.
    minCoveredMsi: 97,
    // Low on purpose. A mutant that loops forever is ordinary here — the redactor and
    // the frame walk with budgets, and removing a budget is exactly the mutation — and
    // every one of those otherwise costs the whole timeout. The real work per mutant is
    // the few tests covering one line, which take well under a second even through a
    // slow mount.
    timeout: 10,
}
