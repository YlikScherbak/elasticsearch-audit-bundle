<?xml version="1.0" encoding="UTF-8" ?>
<!--
    What the backward-compatibility check is told to let through, each a change made on
    purpose and said in CHANGELOG.md. A line here is a decision, never a way to a green job:
    name the one change, the release that made it and why it is not a break in practice.
-->
<roave-bc-check
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="tools/bc-check/vendor/roave/backward-compatibility-check/Resources/schema.xsd">
    <baseline>
        <!--
            1.2.6 / 1.3.1: redact.max_depth and redact.max_nodes default to ~. A null limit
            means 16 and 10 000 where a rule is followed - what the old defaults were - and
            JSON's own bounds where none is, since every record is now made plain on its way
            out and the old defaults would refuse records no rule asked about.
        -->
        <ignored-regex>#\[BC\] CHANGED: Default parameter value for parameter \$maxDepth of Borsche\\ElasticsearchAuditBundle\\Privacy\\ChangeRedactor\#__construct\(\) changed from 16 to NULL#</ignored-regex>
        <ignored-regex>#\[BC\] CHANGED: Default parameter value for parameter \$maxNodes of Borsche\\ElasticsearchAuditBundle\\Privacy\\ChangeRedactor\#__construct\(\) changed from 10000 to NULL#</ignored-regex>
    </baseline>
</roave-bc-check>
