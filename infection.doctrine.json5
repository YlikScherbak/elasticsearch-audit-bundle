{
    // Mutation testing for the Doctrine listener, kept apart from infection.json5.
    //
    // Two things make it its own run rather than another directory in that one. The
    // tests are slow — each builds an EntityManager and a schema — so a mutant here
    // needs a timeout that would let a genuinely looping mutant in the redactor run for
    // a minute before anyone noticed. And the run takes minutes rather than a minute,
    // which is fine for a job of its own and not fine for the one somebody waits on.
    //
    // Nothing from the other file's ignore list is repeated here, and nothing needs to
    // be: those entries name classes this run does not mutate.
    $schema: "tools/infection/vendor/infection/infection/resources/schema.json",
    source: {
        directories: [
            "src/Doctrine",
        ],
    },
    logs: {
        text: "var/infection/doctrine-escaped.log",
        summary: "var/infection/doctrine-summary.log",
    },
    mutators: {
        "@default": true,

        // Equivalent mutants, and only the ones that are equivalent *by construction* —
        // where there is nothing to tell apart rather than no test that tells it apart.
        // The difference matters: an ignored mutant is never generated, so a wrong claim
        // here has nothing left to contradict it, which is exactly how two wrong claims
        // survived in the other config until the ignores there were narrowed to lines.
        //
        // Everything else that escapes stays escaping. The list of those lives in the
        // commits that work through them, not here.

        // Four re-listings on one road, and no single one of them is observable.
        //
        // What a collection is recorded as passes through two of them whichever way it
        // was emptied: the snapshot the listener kept (rememberWhatIsBeingEmptied) or
        // what the field holds now (contentsOf), and then representAll on the way into
        // the Change. Doctrine hands a collection over keyed when the mapping says
        // indexBy, so the keys are real — and either re-listing alone straightens them
        // out, which is why Infection, changing one thing at a time, sees nothing.
        //
        // Measured rather than argued, with a fixture whose collection is keyed by its
        // elements' codes: snapshot alone, representAll alone, contentsOf alone — all
        // pass; snapshot together with representAll fails, and contentsOf together with
        // representAll fails. Two pairs, two facts, in
        // WhatARemovalAndAClearRecordTest, which asks for the keys of both sides of the
        // record by name.
        //
        // collectionChange::250 is the fourth, over a list it built itself.
        UnwrapArrayValues: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\ChangeSetBuilder::representAll::220", "Borsche\\ElasticsearchAuditBundle\\Doctrine\\ChangeSetBuilder::collectionChange::250", "Borsche\\ElasticsearchAuditBundle\\Doctrine\\ChangeSetBuilder::contentsOf::234", "Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::rememberWhatIsBeingEmptied::587"],
        },

        // collectionChange builds the list a collection is recorded as, and it is
        // protected twice: array_values() around the map, and iterator_to_array() told
        // not to keep keys. Either one alone makes the other redundant, so a mutation of
        // either is invisible — Infection changes one thing at a time. Taking out both
        // does produce the hole a removal from the middle leaves in the keys, and
        // WhatAnElementChangeIsMadeOfTest fails on it, which is the property being
        // pinned. Two mutants, one fact.
        FalseValue: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\ChangeSetBuilder::collectionChange::252"],
        },

        // The mapping of a to-many is an array on ORM 2 and an object on ORM 3, and the
        // ternary reads both. This run installs one of them, so the other arm is not
        // reachable here — it is reachable in the job that runs the ORM this one does
        // not, which is why the arm stays.
        Ternary: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::rememberWhatIsBeingEmptied::562"],
        },

        // The manager of the flush on the stack, read through a weak reference that is
        // written in the same breath as the stack itself. The branch asking for it is
        // reached only when the stack is not empty, and the stack is only ever appended
        // to beside that reference — so it is never null where the question is asked.
        NullSafeMethodCall: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::beginFlush::1456"],
        },

        // Publishing a flush that committed late runs application code, so it is wrapped
        // in a catch for Throwable that reports and swallows. Nothing can leave the try
        // by any other road, which makes "in a finally" and "on the line after" the same
        // thing. The finally stays because the day something is added that can escape,
        // the flush still has to be forgotten.
        UnwrapFinally: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::beginFlush::1473"],
        },

        // asTheEntityNowStands walks a Doctrine change set, whose entries are always a
        // two-element array of the old and new sides. Both of the first two guards are
        // therefore constant: is_array() is always true and array_key_exists(1, ...)
        // with it, so neither the index nor the way the three are joined can change the
        // answer. They are there because the method is handed a snapshot the listener
        // kept, and a snapshot is only as well-formed as whoever filled it.
        DecrementInteger: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::asTheEntityNowStands::2436", "Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::whoseAnswerIsCurrent::2200"],
        },

        // The same premise one method further on. forgetWhatThisFlushCollected() reads
        // the old side out of a change set the listener kept, and an entry of one is
        // always the two-element array Doctrine builds -- so asking for key 0 and asking
        // for key 1 are the same question, and joining that with is_array() either way
        // reaches the same place. The guard is there because the map is the listener's
        // own and a snapshot is only as well-formed as whoever filled it.
        IncrementInteger: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::forgetWhatThisFlushCollected::1309", "Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::whoseAnswerIsCurrent::2200"],
        },
        LogicalAnd: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::forgetWhatThisFlushCollected::1309"],
        },

        // What a flush that never happened had found the row holding, filled once and
        // spent by the next change set for that entity. Within one call the fields of an
        // entity are distinct; across calls the snapshot it was read from is taken away
        // in the same breath, so the key cannot be filled twice without something having
        // spent it in between. "The earliest answer wins" and "the only answer wins" are
        // therefore the same rule, and the ??= says which one is meant.
        AssignCoalesce: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::forgetWhatThisFlushCollected::1310"],
        },


        LogicalOr: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::asTheEntityNowStands::2436", "Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::recordForOwner::2314"],
        },

        // Two guards that never fire, kept for the day they can.
        //
        // - recordForOwner() asks whether the owner has a declaration and whether the
        //   manager is an entity manager. Neither is ever no: an owner is in that map
        //   because holdMembership() read its declaration to put it there, and the
        //   manager comes from a Doctrine event, which always hands one over — the
        //   narrowing is against the oldest doctrine/persistence, whose signature only
        //   promises an ObjectManager. With both answers fixed, joining them either way
        //   reaches the same place.
        // - the early return in assertTrackedCollectionsAreServable() for a class that
        //   tracks no collections. Everything after it is a loop over that empty list
        //   and the keys for a cache of its result, so removing the return costs a
        //   metadata lookup and changes nothing anybody can observe.

        // latestPerKey() picks the entry with the highest stamp, and every stamp is one
        // more than the last one handed out: unique, and counting from one. So the
        // comparison cannot be told from its neighbours -- < and <= are the same over
        // distinct numbers, and the floor a name with no stamp yet is compared against is
        // below every stamp whether it is -1, 0 or -2, or absent and read as null. Four
        // ways of writing one question.
        LessThan: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::whoseAnswerIsCurrent::2200"],
        },

        ReturnRemoval: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::assertTrackedCollectionsAreServable::1808"],
        },

        // Two `continue`s with nothing behind them to skip, each for its own reason.
        //
        // - elementChanges() passes over an association of an element, and Doctrine
        //   reports every column of a change set before every association: measured,
        //   with a fixture built for it (Chute declares its inspector before its size
        //   and the change set still comes back as ["size", "inspector"]). So the skip
        //   is always the last iteration. The guard below it is not equivalent and has
        //   a test — WhatAnElementChangeIsMadeOfTest asks for the column by name, which
        //   is also what would fail if a future ORM reordered them.
        // - holdElementChanges() drops an element's empty entry while walking the
        //   owner's audited fields, and at most one of those can be this element's
        //   collection: the guards above demand that the field be mapped by the very
        //   association the element points back through, and a class cannot map two
        //   collections through one property. Whatever follows a match either fails
        //   those guards and skips itself, or is the same mapping written twice.
        Continue_: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\ChangeSetBuilder::elementChanges::188", "Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::holdElementChanges::2059"],
        },

        // The always-recorded context of an owner that had no event of its own is applied
        // twice: recordForOwner() hands the flush's snapshot to the builder for an
        // emptied collection, and withContext() applies the same snapshot to the finished
        // change set a few lines later. Either one alone covers the other, so a mutation
        // of either is invisible — Infection changes one thing at a time. Taking out both
        // loses the context, and WhoseMomentALateRecordCarriesTest fails on it, which is
        // the property being pinned. One mutant, one fact, one guard.
        Coalesce: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::recordForOwner::2338", "Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::whoseAnswerIsCurrent::2200"],
        },

        // An owner whose collection was emptied is remembered twice: once where the
        // emptying is noticed and once where the elements it lost are. A collection can
        // only be emptied by clearing or replacing it, and both of those are also
        // elements lost — so either call alone covers the other, and Infection changes
        // one thing at a time. Measured both ways round: remove either and
        // WhoseMomentALateRecordCarriesTest still passes, remove both and it fails on an
        // owner the inner flush only emptied. The emptying road keeps its call because
        // it is the one that runs in onFlush, before any element event, and a future
        // road into it that is not also a membership change would find the map already
        // filled in.
        MethodCallRemoval: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::rememberWhatIsBeingEmptied::586"],
        },

        // stringify's arm for a BackedEnum, which nothing reaches: Doctrine hands an
        // identifier back as the value behind the case rather than as the case, so an
        // enum-identified entity arrives here as the int or string it is backed by and
        // is answered by the arm above. Measured with a fixture — Berth is identified by
        // an int-backed enum and its record carries 2, not "2" — and the arm stays,
        // because "the identifier is whatever the mapping hands over" is not a promise
        // Doctrine makes in writing. The Stringable arm beside it is reached, and has a
        // test.
        CastString: {
            ignore: ["Borsche\\ElasticsearchAuditBundle\\Doctrine\\AuditSubscriber::stringify::2550"],
        },
    },
    // Its own floor, and well below the other run's, because this listener is the code
    // the bundle calls its price of complexity: one class answering for every shape a
    // Doctrine flush can take.
    //
    // 97 against 99.15 measured, which is the same arrangement the other file argues
    // for: a floor set at the best observed number turns ordinary drift into a job that
    // fails for no reason, and a check nobody trusts is worse than none.
    //
    // It moves up a group of escaped mutants at a time, the way that one did. 72 escaped
    // when this was first measured honestly; the flush bookkeeping, the always-recorded
    // context, the walk over an element's owners, what a change inside an element is
    // built from, the wording of every refused declaration, what an abandoned flush
    // counted, which keys a corrected element owns, what an identifier that is not a
    // scalar becomes and what a collection Doctrine keys is recorded as have been
    // worked through since, and 6 are left. Four arrived with the three fixes of 1.2.4
    // and three of them were worked through in the same breath; the fourth is the `??`
    // on the context an owner kept when Doctrine gave it no event, which no arrangement
    // of fixtures reaches — an owner that emptied a collection *and* was updated has a
    // record already, so it never takes that road — and which therefore stays escaping
    // rather than being claimed equivalent. Sixteen of the escaped mutants turned out
    // to be equivalent by construction and are listed above with the reason. Each
    // commit that takes a group names what remains.
    //
    // The line numbers above go stale when a method moves, the mutant is generated
    // again and this job goes red. That is the arrangement working, not breaking: it
    // happened on the commit that taught the listener about a flush whose only history
    // came from inside a collection, and every claim had to be pointed at its line
    // again — which is the moment to notice if one of them stopped being true.
    minCoveredMsi: 97,
    // Six times the other run's. A test here is a schema and an EntityManager before it
    // is an assertion, so the work per mutant is a second or two rather than well under
    // one, and at 10 seconds the runner was calling eighty-eight of them timeouts — each
    // of which counts as a kill and quietly lifts the score.
    timeout: 60,
}
